extends Node
## Sound manager (autoload "Audio"): sound effects, looping music and the on/off settings.
## Sounds live in assets/audio/sfx/<name>.wav and assets/audio/music/<track>.wav
## (generated by tools/make_audio.py; replace any file with your own).

const SFX_DIR := "res://assets/audio/sfx/"
const MUSIC_DIR := "res://assets/audio/music/"
const SETTINGS := "user://settings.cfg"
const AMBIENCE_DIR := "res://assets/audio/ambience/"
## Music per room (default "explore"). 2nd floor: explore. Ground floor: lobby. Basement and IT: basement.
## 3rd floor: executive. The server room and the elevator have their own.
const ROOM_MUSIC := {
	"office": "explore", "hallway": "explore", "conference": "explore", "boss": "explore",
	"lobby": "lobby", "breakroom": "lobby",
	"basement": "basement", "closet": "basement", "itlab": "basement", "itmgr": "basement",
	"floor3": "executive", "accounting": "executive", "vp": "executive", "ceo": "executive",
	"server": "server", "elevator": "elevator",
}
## Quiet looping room tone per room (none: silence). Switched off with "Sound effects".
const ROOM_AMBIENCE := {
	"office": "amb_office", "hallway": "amb_office", "conference": "amb_office", "boss": "amb_office",
	"floor3": "amb_office", "accounting": "amb_office", "vp": "amb_office", "ceo": "amb_office",
	"lobby": "amb_lobby", "breakroom": "amb_breakroom",
	"basement": "amb_basement", "closet": "amb_basement", "itlab": "amb_it", "itmgr": "amb_it", "server": "amb_it",
}
const POOL := 8  # sound effects that can overlap

var music_on := true
var sfx_on := true
var _streams := {}
var _pool: Array[AudioStreamPlayer] = []
var _music: Array[AudioStreamPlayer] = []
var _cur := 0
var _track := ""
var _fade: Tween
var _amb: Array[AudioStreamPlayer] = []
var _amb_cur := 0
var _amb_name := ""
var _amb_fade: Tween


func _ready() -> void:
	_load_settings()
	_make_bus("Music", -6.0)
	_make_bus("SFX", -3.0)
	_make_bus("Ambience", -14.0)
	for i in POOL:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.bus = "Music"
		add_child(m)
		_music.append(m)
	for i in 2:
		var a := AudioStreamPlayer.new()
		a.bus = "Ambience"
		add_child(a)
		_amb.append(a)
	_apply_mutes()


func _make_bus(bus_name: String, db: float) -> void:
	AudioServer.add_bus()
	var i := AudioServer.bus_count - 1
	AudioServer.set_bus_name(i, bus_name)
	AudioServer.set_bus_send(i, "Master")
	AudioServer.set_bus_volume_db(i, db)


func _get_stream(path: String) -> AudioStream:
	if not _streams.has(path):
		_streams[path] = load(path) if ResourceLoader.exists(path) else null
		if _streams[path] == null:
			push_warning("Missing audio file: " + path)
	return _streams[path]


## Plays a sound effect. `pitch` 1.0 = as recorded; volume_db 0 = full.
func play(sfx_name: String, pitch: float = 1.0, volume_db: float = 0.0) -> void:
	if not sfx_on:
		return
	var s := _get_stream(SFX_DIR + sfx_name + ".wav")
	if s == null:
		return
	var p: AudioStreamPlayer = _pool[0]
	for q in _pool:
		if not q.playing:
			p = q
			break
	p.stream = s
	p.pitch_scale = pitch
	p.volume_db = volume_db
	p.play()


## Crossfades to a looping music track (no-op if it is already playing).
func play_music(track: String) -> void:
	if track == _track:
		return
	_track = track
	var path := MUSIC_DIR + track + ".wav"
	if not ResourceLoader.exists(path):
		path = MUSIC_DIR + track + ".mp3"
	var s := _get_stream(path)
	if s == null:
		return
	if s is AudioStreamMP3:
		(s as AudioStreamMP3).loop = true
	if s is AudioStreamWAV:
		# Loop the whole file. Length is measured in samples; don't count bytes, because Godot
		# may store imported WAVs compressed.
		var wav: AudioStreamWAV = s
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = int(round(wav.get_length() * wav.mix_rate))
	var out := _music[_cur]
	_cur = 1 - _cur
	var inc := _music[_cur]
	inc.stream = s
	inc.volume_db = -40.0
	inc.play()
	if _fade:
		_fade.kill()
	_fade = create_tween().set_parallel(true)
	_fade.tween_property(inc, "volume_db", 0.0, 1.2)
	if out.playing:
		_fade.tween_property(out, "volume_db", -40.0, 1.2)
		_fade.chain().tween_callback(out.stop)


## Crossfades to a looping room tone ("" fades it out). No-op if it is already playing.
func play_ambience(amb_name: String) -> void:
	if amb_name == _amb_name:
		return
	_amb_name = amb_name
	var out := _amb[_amb_cur]
	var inc: AudioStreamPlayer = null
	if amb_name != "":
		var s := _get_stream(AMBIENCE_DIR + amb_name + ".wav")
		if s is AudioStreamWAV:
			var wav: AudioStreamWAV = s
			wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
			wav.loop_begin = 0
			wav.loop_end = int(round(wav.get_length() * wav.mix_rate))
		if s != null:
			_amb_cur = 1 - _amb_cur
			inc = _amb[_amb_cur]
			inc.stream = s
			inc.volume_db = -40.0
			inc.play()
	if _amb_fade:
		_amb_fade.kill()
	_amb_fade = create_tween().set_parallel(true)
	if inc != null:
		_amb_fade.tween_property(inc, "volume_db", 0.0, 1.5)
	if out.playing and out != inc:
		_amb_fade.tween_property(out, "volume_db", -40.0, 1.5)
		_amb_fade.chain().tween_callback(out.stop)


func stop_music(fade_seconds: float = 1.5) -> void:
	_track = ""
	var out := _music[_cur]
	if not out.playing:
		return
	if _fade:
		_fade.kill()
	_fade = create_tween()
	_fade.tween_property(out, "volume_db", -40.0, fade_seconds)
	_fade.tween_callback(out.stop)


func set_music(on: bool) -> void:
	music_on = on
	_apply_mutes()
	_save_settings()


func set_sfx(on: bool) -> void:
	sfx_on = on
	_apply_mutes()
	_save_settings()


func _apply_mutes() -> void:
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Music"), not music_on)
	AudioServer.set_bus_mute(AudioServer.get_bus_index("SFX"), not sfx_on)
	AudioServer.set_bus_mute(AudioServer.get_bus_index("Ambience"), not sfx_on)


func _load_settings() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS) == OK:
		music_on = cfg.get_value("audio", "music", true)
		sfx_on = cfg.get_value("audio", "sfx", true)


func _save_settings() -> void:
	var cfg := ConfigFile.new()
	cfg.set_value("audio", "music", music_on)
	cfg.set_value("audio", "sfx", sfx_on)
	cfg.save(SETTINGS)
